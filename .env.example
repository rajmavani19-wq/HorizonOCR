# HorizonOCR production environment template
# Copy to .env for local use. Inject real values through your production host's secret manager.

APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret-managed-outside-source-control
DATA_DIR=/var/lib/horizonocr
PORT=8080
LOG_LEVEL=INFO
SESSION_LIFETIME_HOURS=12

# Set only when the frontend is hosted on a different approved HTTPS origin.
# Comma-separate multiple origins. Leave empty for the recommended same-origin deployment.
ALLOWED_ORIGINS=

# Set when the app is behind a trusted TLS-terminating proxy/load balancer.
TRUSTED_PROXY_HOPS=1

# Resource limits for the synchronous web API.
MAX_UPLOAD_BYTES=52428800
MAX_DOCUMENT_PAGES=25
MAX_IMAGE_PIXELS=40000000
